# Copia questo file in server/.env e personalizza i valori. Il file .env non va mai committato.

# Porta e interfaccia di ascolto (default: 3001; localhost in sviluppo, 0.0.0.0 in produzione)
# PORT=3001
# HOST=localhost

# Segreto per firmare i cookie di sessione: OBBLIGATORIO in produzione, almeno 32 caratteri casuali.
# Generane uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In sviluppo, se assente, ne viene generato uno e salvato in server/data/.session-secret
# SESSION_SECRET=

# Cartella e nome del database SQLite (default: server/data/meme-game.db)
# DATA_DIR=data
# DB_FILE=meme-game.db

# Crea gli account demo (user/testpass, prova/prova) al primo avvio (default: true)
# SEED_DEMO_DATA=true

# Cookie "Secure" e HSTS: attivali quando l'app è servita in HTTPS (default: true in produzione)
# SECURE_COOKIES=true

# Dietro un reverse proxy (nginx, Caddy, PaaS): numero di proxy fidati, per IP e protocollo corretti
# TRUST_PROXY=1

# Origini aggiuntive ammesse per le richieste che modificano dati, separate da virgola
# ALLOWED_ORIGINS=https://memegame.example.com

# Log di ogni richiesta (default: true in sviluppo)
# LOG_REQUESTS=false

# Servire il client compilato (client/dist) dallo stesso processo (default: true in produzione)
# SERVE_CLIENT=true
