{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "description": "API del Meme Game: Express 5, sessioni su SQLite (node:sqlite), partite gestite lato server.",
  "type": "module",
  "main": "src/index.mjs",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.mjs",
    "start": "node --env-file-if-exists=.env src/index.mjs --production",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0"
  }
}
