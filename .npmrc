# Supply-chain hardening — read before changing (see README → "Sicurezza").
#
# Never run install-time lifecycle scripts of dependencies (preinstall/install/postinstall):
# they are the main infection vector of npm worms. No dependency of this project needs them.
ignore-scripts=true
# Only install versions published at least 7 days ago: compromised releases are usually
# detected and unpublished within hours.
min-release-age=7
# Never fetch dependencies from git repositories or arbitrary URLs.
allow-git=none
# Refuse packages that are not compatible with the current Node.js version.
engine-strict=true
# Pin exact versions in package.json (the lockfile pins the whole tree).
save-exact=true
# `npm audit` fails from "moderate" severity upward.
audit-level=moderate
fund=false
